# Configuración de Supabase para ARBOL-GEN-PRO.
# Copiar a `.env` y completar con los valores reales del proyecto.
# `.env` está en `.gitignore`: nunca se versiona.

# URL del proyecto Supabase (sin barra final).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública (anon). Es segura para el navegador SIEMPRE que
# las RLS estén activas en el 100% de las tablas (RNF-03.1).
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
